{
  "buildCommand": "cd farmneura_fullstack/frontend && npm install && npm run build",
  "outputDirectory": "farmneura_fullstack/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://farmneura-v2.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://farmneura-v2.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
